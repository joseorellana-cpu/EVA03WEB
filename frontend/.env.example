# URL base del API Gateway. Vacía = mismo origen (recomendado
# detrás de nginx con proxy inverso /api → Gateway).
VITE_API_BASE_URL=

# Sólo para el proxy de desarrollo de Vite (no versionar valores
# reales de entornos privados; aquí sólo localhost, sin secretos).
VITE_API_PROXY_TARGET=http://localhost:8080
