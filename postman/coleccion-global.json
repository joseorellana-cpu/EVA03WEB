							"pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
							"var json = pm.response.json();",
							"pm.test('Contrato ProveedorResponse completo', function () {",
							"    ['id','ruc','razonSocial','nombreComercial','email','telefono','direccion','estado','fechaRegistro','creadoPor','modificadoPor'].forEach(function (campo) {",
							"        pm.expect(json).to.have.property(campo);",
							"    });",
							"});",
							"pm.test('creadoPor y modificadoPor registran usuario', function () {",
							"    pm.expect(json.creadoPor).to.be.a('string').and.to.have.length.above(0);",
