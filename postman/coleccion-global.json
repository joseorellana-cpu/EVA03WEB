		{
			"name": "03B Aceptacion (prueba de aceptacion oficial)",
			"item": [
				{
					"name": "ACEPTACION - Compra con dos productos y total",
					"request": {
						"method": "POST",
						"description": "Prueba de aceptacion de la guia oficial:\nproveedor 1 (ACTIVO)\nproducto 1 x 10 a precioUnitario 12.50\nproducto 2 x 2  a precioUnitario 189.90\nNO descuenta stock (estado REGISTRADA).\n\nVerificacion SQL en bd_compra:\nSELECT d.producto_id, d.cantidad, d.precio_unitario, d.subtotal\nFROM bd_compra.compra_detalles d\nWHERE d.compra_id = (SELECT MAX(id) FROM bd_compra.compras)\nORDER BY d.producto_id;\n\nSELECT total FROM bd_compra.compras\nWHERE id = (SELECT MAX(id) FROM bd_compra.compras);",
						"header": [
							{ "key": "X-Usuario", "value": "{{usuario}}", "type": "text" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"proveedorId\": 1,\n  \"observaciones\": \"ACEPTACION - Compra con dos productos y total\",\n  \"detalles\": [\n    { \"productoId\": 1, \"cantidad\": 10, \"precioUnitario\": 12.50 },\n    { \"productoId\": 2, \"cantidad\": 2,  \"precioUnitario\": 189.90 }\n  ]\n}" },
						"url": { "raw": "{{baseUrl}}/api/compras", "host": ["{{baseUrl}}"], "path": ["api", "compras"] }
					},
					"event": [{
						"listen": "test",
						"script": { "exec": [
							"pm.test('HTTP 201 Creado', function () { pm.response.to.have.status(201); });",
							"var json = pm.response.json();",
							"pm.test('Estado inicial REGISTRADA', function () { pm.expect(json.estado).to.eql('REGISTRADA'); });",
							"pm.test('numeroCompra con formato C-AAAA-NNNNNN', function () { pm.expect(json.numeroCompra).to.match(/^C-\\d{4}-\\d{6}$/); });",
							"pm.test('Detalle 1: producto 1, cantidad 10, precioUnitario 12.50', function () {",
							"    pm.expect(json.detalles[0].productoId).to.eql(1);",
							"    pm.expect(json.detalles[0].cantidad).to.eql(10);",
							"    pm.expect(Number(json.detalles[0].precioUnitario)).to.eql(12.50);",
							"});",
							"pm.test('Detalle 2: producto 2, cantidad 2, precioUnitario 189.90', function () {",
							"    pm.expect(json.detalles[1].productoId).to.eql(2);",
							"    pm.expect(json.detalles[1].cantidad).to.eql(2);",
							"    pm.expect(Number(json.detalles[1].precioUnitario)).to.eql(189.90);",
							"});",
							"pm.test('subtotal 1 = 125.00', function () { pm.expect(Number(json.detalles[0].subtotal).toFixed(2)).to.eql('125.00'); });",
							"pm.test('subtotal 2 = 379.80', function () { pm.expect(Number(json.detalles[1].subtotal).toFixed(2)).to.eql('379.80'); });",
							"pm.test('TOTAL = 504.80', function () { pm.expect(Number(json.total).toFixed(2)).to.eql('504.80'); });",
							"pm.test('creadoPor es el header X-Usuario', function () { pm.expect(json.creadoPor).to.eql(pm.collectionVariables.get('usuario')); });"
						] }
					}]
				}
			]
