							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"ruc\": \"20551234567\",\n  \"razonSocial\": \"COMERCIAL PACIFICO SUR S.A.\",\n  \"nombreComercial\": \"Pac\u00edfico Sur\",\n  \"email\": \"ventas@pacificosur.pe\",\n  \"telefono\": \"01-7654321\",\n  \"direccion\": \"Av. Arequipa 2350, Lince\"\n}" },
						"url": { "raw": "{{baseUrl}}/api/proveedores", "host": ["{{baseUrl}}"], "path": ["api", "proveedores"] }
					},
					"event": [{
						"listen": "test",
						"script": { "exec": [
							"pm.test('HTTP 201 Creado', function () { pm.response.to.have.status(201); });",
							"var json = pm.response.json();",
							"pm.test('Estado inicial ACTIVO', function () { pm.expect(json.estado).to.eql('ACTIVO'); });",
							"pm.test('creadoPor es el header X-Usuario', function () { pm.expect(json.creadoPor).to.eql(pm.collectionVariables.get('usuario')); });",
